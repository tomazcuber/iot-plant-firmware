/* What apps/main alone needs on top of the plant_sensors shield
 * (NFR-MA-04). The shield's zephyr,user node (io-channels) merges with this
 * one. */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		/* Phase markers (FR-MA-18): index 0 = code bit 1 = GPIO18 (to the
		 * Reader's GPIO6), index 1 = code bit 0 = GPIO19 (to the Reader's
		 * GPIO7). Same port and active high: phase_markers.c writes both
		 * in one masked register write. */
		marker-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>,
			       <&gpio0 19 GPIO_ACTIVE_HIGH>;

		/* LM393 DO, the deep-sleep wake source (FR-MA-06, SM-06). "Active"
		 * means past the threshold (dry). The polarity is NOT yet confirmed
		 * on the bench (#26): if DO reads low when dry, change this one
		 * flag to GPIO_ACTIVE_LOW. No internal pull: the module drives DO. */
		soil-alert-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
	};
};

/* Unused (CONFIG_SPI is off), but the board's default pinctrl for it claims
 * GPIO6 as SCLK. */
&spi2 {
	status = "disabled";
};
