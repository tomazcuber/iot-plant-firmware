mainmenu "Plant Monitor — Main Application"

# Compile-time configuration of the reduced apps/main (issue #22): BLE
# provisioning and Settings are cut, so these replace the Settings keys of
# FR-MA-05a.

config APP_READ_INTERVAL_S
	int "Read interval (s): Sleep length between Cycles"
	default 300
	range 10 86400
	help
	  Set per experiment condition with interval-60.conf / interval-300.conf,
	  never on the command line.

config APP_DEVICE_NAME
	string "Device name (MQTT topic segment and client id)"
	default "plant"
	help
	  FR-MA-05 default. Shorter than 64 bytes (MQTT client id limit).

config APP_WIFI_SSID
	string "WiFi SSID"

config APP_WIFI_PSK
	string "WiFi PSK"

config APP_MQTT_BROKER
	string "MQTT broker host (IPv4 literal or DNS name)"

source "Kconfig.zephyr"
